{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "react",
    "react-perf",
    "jsx-a11y",
    "nextjs",
    "vitest"
  ],
  "ignorePatterns": ["vendor/**"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css", "**/*.scss"] }],
    "import/no-relative-parent-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error"
  },
  "overrides": [
    {
      // First, so the domain's and the use cases' own lists below replace it for their files
      "files": ["src/**"],
      "excludeFiles": ["src/shared/ui/app-link/app-link.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "next/link",
                "importNames": ["default"],
                "message": "Use AppLink, so a slow navigation shows on the bar along the top."
              }
            ]
          }
        ]
      }
    },
    {
      // The web's doors - pages, screens, their commands - reach storage through use cases and ports; logging and the
      // clock are the infrastructure they use. Repeats the AppLink rule, which this list replaces for them.
      "files": ["src/app/**", "src/features/*/web/**", "src/shared/web/**"],
      "excludeFiles": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "next/link",
                "importNames": ["default"],
                "message": "Use AppLink, so a slow navigation shows on the bar along the top."
              }
            ],
            "patterns": [
              {
                "group": [
                  "drizzle-orm",
                  "drizzle-orm/*",
                  "drizzle-kit",
                  "@/features/*/infrastructure/**",
                  "@/shared/infrastructure/d1/**"
                ],
                "message": "A door reaches storage through a use case, not the tables."
              }
            ]
          }
        ]
      }
    },
    {
      // The bot, the queue and the cron: doors too, and none renders a page. They share the web's words - the copy,
      // text and path modules under web/, which stay plain TypeScript for that - never its components.
      "files": ["src/bot/**", "src/jobs/**"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "drizzle-orm",
                  "drizzle-orm/*",
                  "drizzle-kit",
                  "@/features/*/infrastructure/**",
                  "@/shared/infrastructure/d1/**"
                ],
                "message": "A door reaches storage through a use case, not the tables."
              },
              {
                "group": ["react", "react-dom", "next", "next/*", "vinext", "vinext/*", "@/app/**"],
                "message": "The bot and the jobs share the web's words, not its pages or components."
              }
            ]
          }
        ]
      }
    },
    {
      // One person on one page: every step waits for the one before it
      "files": ["e2e/**"],
      "rules": { "no-await-in-loop": "off" }
    },
    {
      "files": ["src/features/*/domain/**", "src/shared/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["drizzle-orm", "drizzle-orm/*", "drizzle-kit"],
                "message": "The domain knows nothing about persistence."
              },
              { "regex": "^cloudflare:", "message": "The domain knows nothing about the runtime." },
              {
                "group": [
                  "@/features/*/application/**",
                  "@/features/*/infrastructure/**",
                  "@/features/*/web/**",
                  "@/shared/application/**",
                  "@/shared/infrastructure/**",
                  "@/shared/web/**",
                  "@/bot/**",
                  "@/jobs/**",
                  "@/composition/**"
                ],
                "message": "The domain depends on nothing above it."
              },
              {
                "group": [
                  "react",
                  "react-dom",
                  "next",
                  "next/*",
                  "vinext",
                  "vinext/*",
                  "@/app/**",
                  "@/shared/ui/**"
                ],
                "message": "The domain knows nothing about the UI."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/*/application/**", "src/shared/application/**"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["drizzle-orm", "drizzle-orm/*", "drizzle-kit"],
                "message": "Use cases reach storage through ports, not the ORM."
              },
              { "regex": "^cloudflare:", "message": "Use cases do not depend on the runtime." },
              {
                "group": [
                  "@/features/*/infrastructure/**",
                  "@/shared/infrastructure/**",
                  "@/composition/**"
                ],
                "message": "Use cases depend on ports; only src/composition wires infrastructure in."
              },
              {
                "group": ["@/features/*/web/**", "@/shared/web/**", "@/bot/**", "@/jobs/**"],
                "message": "Use cases know nothing about the doors that call them."
              },
              {
                "group": [
                  "react",
                  "react-dom",
                  "next",
                  "next/*",
                  "vinext",
                  "vinext/*",
                  "@/app/**",
                  "@/shared/ui/**"
                ],
                "message": "Use cases know nothing about the UI."
              }
            ]
          }
        ]
      }
    }
  ]
}
