{
  "name": "daybook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview",
    "deploy": "vinext-cloudflare deploy",
    "typecheck": "cf workers types && tsc",
    "lint": "oxlint && stylelint \"**/*.scss\"",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bddgen && playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "cf d1 migrations apply f116c00d-1ef3-4841-831b-e821c5f8a29b --local --persist-to .cloudflare/state --dir migrations --pattern \"migrations/*/migration.sql\""
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@vinext/cloudflare": "1.1.1",
    "drizzle-orm": "1.0.0-rc.4",
    "lucide-react": "1.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "temporal-polyfill": "1.0.6",
    "uuid": "14.0.3",
    "vinext": "1.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-c82c3efb3",
    "@cloudflare/vitest-plugin": "1.4.2",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "cf": "1.0.0-beta.17",
    "drizzle-kit": "1.0.0-rc.4",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright-bdd": "9.2.1",
    "sass-embedded": "1.105.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-css-modules": "1.16.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.11.2"
}
