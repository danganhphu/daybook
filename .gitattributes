## LF in the repo and the working tree. Plain `text=auto` defers to core.autocrlf (true on this machine): a phantom
## CRLF diff on every file.
* text=auto eol=lf

## cmd.exe can misread a label or goto target that ends in a bare LF
*.cmd   text eol=crlf
*.bat   text eol=crlf

## Binary - never diff, never normalise
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.avif  binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.zip   binary
*.gz    binary

pnpm-lock.yaml linguist-generated=true
