root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Four spaces, matching the PowerShell community style guide
[*.{ps1,psm1,psd1}]
indent_size = 4

# cmd.exe can misread a label or goto target that ends in a bare LF
[*.{cmd,bat}]
end_of_line = crlf

# Two trailing spaces are a Markdown hard line break
[*.md]
trim_trailing_whitespace = false
